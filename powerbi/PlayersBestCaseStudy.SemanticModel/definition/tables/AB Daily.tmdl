table 'AB Daily'
	lineageTag: d8b5c3f9-53c7-5887-b501-af4aed544595

	column day
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 02134040-bd55-5c17-8a9b-a0e8c6b0bfb2
		summarizeBy: none
		sourceColumn: day

		annotation UnderlyingDateTimeDataType = Date

	column cum_conv_control
		dataType: double
		formatString: 0.00%
		lineageTag: ccb34e42-73ef-5735-9193-dd23a68c8631
		summarizeBy: none
		sourceColumn: cum_conv_control

	column cum_conv_treatment
		dataType: double
		formatString: 0.00%
		lineageTag: 0ca44516-16f0-530d-8677-da48feb539a4
		summarizeBy: none
		sourceColumn: cum_conv_treatment

	column cum_users
		dataType: int64
		formatString: #,0
		lineageTag: 2997a3cb-d8b5-521e-849e-1ed70d9980d3
		summarizeBy: none
		sourceColumn: cum_users

	column cum_z
		dataType: double
		formatString: 0.00
		lineageTag: 2be574c7-df74-5787-b1a4-57233cb5d768
		summarizeBy: none
		sourceColumn: cum_z

	partition 'AB Daily' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\page4_ab_daily.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
					Typed = Table.TransformColumnTypes(Blanks, {{"day", type date}, {"cum_conv_control", type number}, {"cum_conv_treatment", type number}, {"cum_users", Int64.Type}, {"cum_z", type number}}, "en-US")
				in
					Typed
