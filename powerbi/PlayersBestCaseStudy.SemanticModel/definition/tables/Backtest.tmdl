table Backtest
	lineageTag: 2b5e07cf-7a41-52a6-811f-f67c0dc86333

	column vertical
		dataType: string
		lineageTag: 4934e982-be6d-5294-911e-ac521ea70786
		summarizeBy: none
		sourceColumn: vertical

	column metric
		dataType: string
		lineageTag: c1596055-3682-5645-abeb-83ebb306c09a
		summarizeBy: none
		sourceColumn: metric

	column method
		dataType: string
		lineageTag: c3c56f2f-b739-5491-83c8-7ed381f6fd5e
		summarizeBy: none
		sourceColumn: method

	column mape_daily
		dataType: double
		formatString: 0.0%
		lineageTag: be88cbb4-9ebf-5be9-a488-5391594ecd60
		summarizeBy: none
		sourceColumn: mape_daily

	column mape_weekly
		dataType: double
		formatString: 0.0%
		lineageTag: 7238eb56-29f3-57b8-80be-ce9c98e53ffc
		summarizeBy: none
		sourceColumn: mape_weekly

	column season_error
		dataType: double
		formatString: +0.0%;-0.0%
