		summarizeBy: none
		sourceColumn: coverage_80

	partition Backtest = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\page5_backtest.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
					Typed = Table.TransformColumnTypes(Blanks, {{"vertical", type text}, {"metric", type text}, {"method", type text}, {"mape_daily", type number}, {"mape_weekly", type number}, {"season_error", type number}, {"coverage_80", type number}}, "en-US")
				in
					Typed
