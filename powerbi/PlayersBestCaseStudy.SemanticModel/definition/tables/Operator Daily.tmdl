	partition 'Operator Daily' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "simulated\sim_operator_daily.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
					Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"channel", type text}, {"state", type text}, {"vertical", type text}, {"operator", type text}, {"clickouts", Int64.Type}, {"registrations", Int64.Type}, {"ndcs_tracked", Int64.Type}}, "en-US")
				in
					Typed
