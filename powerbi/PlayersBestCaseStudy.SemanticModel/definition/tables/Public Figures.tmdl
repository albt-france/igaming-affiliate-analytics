	partition 'Public Figures' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "public\affiliates_public.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
					Typed = Table.TransformColumnTypes(Blanks, {{"company", type text}, {"period", type text}, {"metric", type text}, {"dimension", type text}, {"value", type number}, {"unit", type text}, {"source_id", type text}}, "en-US")
				in
					Typed
