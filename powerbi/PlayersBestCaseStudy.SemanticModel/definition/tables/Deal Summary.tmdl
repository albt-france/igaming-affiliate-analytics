					Typed = Table.TransformColumnTypes(Blanks, {{"operator", type text}, {"vertical", type text}, {"current_deal", type text}, {"cpa_offer_usd", type number}, {"revshare_offer_pct", type number}, {"ndcs", Int64.Type}, {"breakeven_month", type number}, {"breakeven_month_discounted", type number}, {"breakeven_p5", type number}, {"breakeven_p95", type number}, {"share_of_boot_never", type number}, {"revshare_24m_usd", type number}, {"revshare_24m_disc_usd", type number}, {"ndcs_observed_m24", Int64.Type}, {"better_deal", type text}}, "en-US")
