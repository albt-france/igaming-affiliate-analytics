table 'Season Totals'
	lineageTag: 3405b845-dabe-5e46-a205-32b77b226490

	column vertical
		dataType: string
		lineageTag: 86633935-aee8-5dce-b138-f27ab5de9aa0
		summarizeBy: none
		sourceColumn: vertical

	column metric
		dataType: string
		lineageTag: f60f6a9c-869a-5706-8b79-8f339e03c1fe
		summarizeBy: none
		sourceColumn: metric

	column forecast_2026_27
		dataType: double
		formatString: #,0
		lineageTag: 7b63a06f-44c8-5f51-a10e-3394a26ede74
		summarizeBy: none
		sourceColumn: forecast_2026_27

	column actual_2025_26
		dataType: double
		formatString: #,0
		lineageTag: 9189cf3e-4f79-5e98-8642-4927d9f4d54a
		summarizeBy: none
