table _Measures
	lineageTag: 1ecc7392-50e7-52e0-981e-eab5bf2c254e

	measure Sessions = SUM ( Traffic[sessions] )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 503661d3-3b4c-599c-8bc7-3254146f67b0

	measure Clickouts = SUM ( Traffic[clickouts] )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 3a17e7b5-8ee4-562d-a74f-961d8d4ab8d1

	measure 'Clickout Rate' = DIVIDE ( [Clickouts], [Sessions] )
		formatString: 0.0%
		displayFolder: Funnel
		lineageTag: 190ea7cd-62d3-5cf0-aae5-df6768fa5d65

	measure Registrations = SUM ( 'Operator Daily'[registrations] )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 110a0324-2114-569a-8067-9c09c120f447

	measure 'Registration Rate' = DIVIDE ( [Registrations], SUM ( 'Operator Daily'[clickouts] ) )
		formatString: 0.0%
		displayFolder: Funnel
		lineageTag: 649fba72-17ca-5ced-b78d-fa40e96d9e67

	measure 'NDCs Reported' = COUNTROWS ( NDCs )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 1ee094bb-25d6-521c-999b-bfaed620e550

	measure 'NDCs Tracked' = SUM ( 'Operator Daily'[ndcs_tracked] )
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 41377246-d735-5417-bd15-f772a2de393a

	measure 'NDC per Clickout' = DIVIDE ( [NDCs Reported], [Clickouts] )
		formatString: 0.00%
		displayFolder: Funnel
		lineageTag: 28697357-5535-56e6-968b-d3450092e2a6

	measure 'Paid Spend' = SUM ( 'Marketing Cost'[spend_usd] )
		formatString: $#,0
		displayFolder: Funnel
		lineageTag: 727554eb-5184-5ece-9348-6ccdbd516c00

	measure 'Revenue 12m' = SUM ( NDCs[revenue_12m_usd] )
		formatString: $#,0
		displayFolder: Value (12m cohorts)
		lineageTag: cffb3eb4-bec4-54d2-82c2-e0988847526c

	measure 'Window Sessions' = CALCULATE ( [Sessions], DATESBETWEEN ( 'Date'[Date], DATE ( 2024, 9, 1 ), DATE ( 2025, 8, 31 ) ) )
		formatString: #,0
		displayFolder: Value (12m cohorts)
		lineageTag: 749ee6fc-7922-5199-a807-e4679b291c8b

	measure 'Window Clickouts' = CALCULATE ( [Clickouts], DATESBETWEEN ( 'Date'[Date], DATE ( 2024, 9, 1 ), DATE ( 2025, 8, 31 ) ) )
		formatString: #,0
		displayFolder: Value (12m cohorts)
		lineageTag: d1376b37-ecdd-5fef-8b24-e2ad365a4326

	measure 'Window NDCs' = CALCULATE ( [NDCs Reported], DATESBETWEEN ( 'Date'[Date], DATE ( 2024, 9, 1 ), DATE ( 2025, 8, 31 ) ) )
		formatString: #,0
		displayFolder: Value (12m cohorts)
		lineageTag: db1f1a67-b203-58d5-94a0-1819e262e152

	measure 'Window Spend' = CALCULATE ( [Paid Spend], DATESBETWEEN ( 'Date'[Date], DATE ( 2024, 9, 1 ), DATE ( 2025, 8, 31 ) ) )
		formatString: $#,0
		displayFolder: Value (12m cohorts)
		lineageTag: c5138c5c-f068-5997-ad4b-9812253d2904

	measure 'Window Clickout Rate' = DIVIDE ( [Window Clickouts], [Window Sessions] )
		formatString: 0.0%
		displayFolder: Value (12m cohorts)
		lineageTag: b4c03853-2317-5d1a-8bd6-48a164ab60fd

	measure 'Window NDC per Clickout' = DIVIDE ( [Window NDCs], [Window Clickouts] )
		formatString: 0.00%
		displayFolder: Value (12m cohorts)
		lineageTag: dc827653-12b6-59ca-948a-ebdef82669be

	measure EPC = DIVIDE ( [Revenue 12m], [Window Clickouts] )
		formatString: $#,0.00
		displayFolder: Value (12m cohorts)
		lineageTag: d2da09d8-0bac-5e5a-8723-2c7ee5cf01cc

	measure 'Revenue per NDC' = DIVIDE ( [Revenue 12m], [Window NDCs] )
		formatString: $#,0
		displayFolder: Value (12m cohorts)
		lineageTag: 949568be-5166-5526-86cd-323b1ff7f553

	measure 'Revenue per Session' = DIVIDE ( [Revenue 12m], [Window Sessions] )
		formatString: $#,0.00
		displayFolder: Value (12m cohorts)
		lineageTag: 0a139bf0-0cb6-5b43-b079-ca81a4a58a66

	measure ROI = IF ( [Window Spend] > 0, DIVIDE ( [Revenue 12m] - [Window Spend], [Window Spend] ) )
		formatString: 0%
		displayFolder: Value (12m cohorts)
		lineageTag: 135eb1b9-d0e0-5b6e-9e50-42cb16b0a1f0

	measure 'GAMB CPA Share 2025' = DIVIDE ( CALCULATE ( SUM ( 'Public Figures'[value] ), 'Public Figures'[metric] = "perf_marketing_mix", 'Public Figures'[dimension] = "CPA", 'Public Figures'[period] = "FY2025" ), 100 )
		formatString: 0%
		displayFolder: Public
		lineageTag: 985a43da-5c8e-5e0e-8bbb-e33d1a8f1f98

	measure 'GAMB Revenue 2025 ($m)' = DIVIDE ( CALCULATE ( SUM ( 'Public Figures'[value] ), 'Public Figures'[company] = "Gambling.com Group", 'Public Figures'[metric] = "revenue", 'Public Figures'[period] = "FY2025" ), 1000 )
		formatString: $#,0.0 \m
		displayFolder: Public
		lineageTag: 0c6bfcd1-46db-58ca-9575-abf628a8e29d

	measure 'GAMB North America Share 2025' = CALCULATE ( SUM ( 'Public KPIs'[value] ), 'Public KPIs'[kpi] = "north_america_share", 'Public KPIs'[year] = "FY2025" )
		formatString: 0%
		displayFolder: Public
		lineageTag: eed4e3ab-91ff-5a2e-ba6b-da06dea99958

	measure 'BC NA Revenue Share 2025' = CALCULATE ( SUM ( 'Public KPIs'[value] ), 'Public KPIs'[kpi] = "revshare_share", 'Public KPIs'[year] = "FY2025", 'Public KPIs'[region] = "North America" )
		formatString: 0%
		displayFolder: Public
		lineageTag: 64e56461-987f-5c0b-82bd-2eb829ad6dce

	measure 'Public KPI Value' = SUM ( 'Public KPIs'[value] )
