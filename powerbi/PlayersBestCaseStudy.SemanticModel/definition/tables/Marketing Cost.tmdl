table 'Marketing Cost'
	lineageTag: be02f8de-65e1-5082-ab00-b78ed69d12b6

	column date
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: d6aa4709-cec9-528c-9b79-fb9b31c8ff22
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column channel
		dataType: string
		lineageTag: 6afe9f19-01f1-5863-8798-6a959404211f
		summarizeBy: none
		sourceColumn: channel

	column state
		dataType: string
		lineageTag: bad39193-1e50-53ae-8322-ecd06a0a8437
		summarizeBy: none
		sourceColumn: state

	column vertical
		dataType: string
		lineageTag: 7d43360c-6b25-56fc-af8d-98d28b4a607f
		summarizeBy: none
		sourceColumn: vertical

	column paid_clicks
		dataType: int64
		formatString: #,0
		lineageTag: 91c6ff3a-5ab8-556c-8c2e-2787fec4432e
		summarizeBy: none
		sourceColumn: paid_clicks

	column spend_usd
		dataType: double
		formatString: $#,0
		lineageTag: b8b04edd-5020-5fa8-9562-bb9fbb34722a
		summarizeBy: none
		sourceColumn: spend_usd

	partition 'Marketing Cost' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "simulated\sim_marketing_cost_daily.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
					Typed = Table.TransformColumnTypes(Blanks, {{"date", type date}, {"channel", type text}, {"state", type text}, {"vertical", type text}, {"paid_clicks", Int64.Type}, {"spend_usd", type number}}, "en-US")
				in
					Typed
