model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Public Figures", "Public KPIs", "Traffic", "Operator Daily", "NDCs", "Marketing Cost", "Operator", "Deal Curves", "Deal Summary", "AB Summary", "AB Stats", "AB Daily", "Forecast", "Backtest", "Season Totals", "Anomaly Flags", "Anomaly Score", "Channel", "State", "Page Type", "Vertical", "Date", "_Measures", "DataFolder"]

ref table 'Public Figures'
ref table 'Public KPIs'
ref table Traffic
ref table 'Operator Daily'
ref table NDCs
ref table 'Marketing Cost'
ref table Operator
ref table 'Deal Curves'
ref table 'Deal Summary'
ref table 'AB Summary'
ref table 'AB Stats'
ref table 'AB Daily'
ref table Forecast
ref table Backtest
ref table 'Season Totals'
ref table 'Anomaly Flags'
ref table 'Anomaly Score'
ref table Channel
ref table State
ref table 'Page Type'
ref table Vertical
ref table Date
ref table _Measures

ref cultureInfo en-US
