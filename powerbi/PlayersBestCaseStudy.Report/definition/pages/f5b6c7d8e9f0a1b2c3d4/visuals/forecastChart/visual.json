              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Weekly actuals and forecast for the 2026-27 season (dotted = 80% interval, indicative when summed to weeks)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}