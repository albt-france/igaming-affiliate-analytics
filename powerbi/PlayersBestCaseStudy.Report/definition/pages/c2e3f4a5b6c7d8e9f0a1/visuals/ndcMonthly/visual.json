{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "ndcMonthly",
  "position": {
    "x": 972,
    "y": 704,
    "z": 14000,
    "height": 324,
    "width": 916,
    "tabOrder": 14000
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
